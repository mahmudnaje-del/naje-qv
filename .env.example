# ADMIN_EMAIL: Gmail / Email for the platform Super Admin.
# Configured via the Secrets / Environment panel in AI Studio.
ADMIN_EMAIL=

# ADMIN_PASSWORD: Password for the platform Super Admin.
# Configured via the Secrets / Environment panel in AI Studio.
ADMIN_PASSWORD=

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PEXELS_API_KEY: Required for Pexels API calls to fetch stock photos.
# Users configure this via the Secrets panel in the AI Studio UI.
PEXELS_API_KEY="MY_PEXELS_API_KEY"

# NAJE_USE_VERTEX_AI: Set to "true" to switch SDK calls from Gemini API Key to Vertex AI Cloud Credits billing.
NAJE_USE_VERTEX_AI=false

# VERTEX_AI_LOCATION: Google Cloud region for Vertex AI endpoints (default: global or us-central1)
VERTEX_AI_LOCATION=global

# GOOGLE_CLOUD_PROJECT: Google Cloud Project ID for Vertex AI billing attribution
GOOGLE_CLOUD_PROJECT=

# ==============================================================================
# NAJE AI - MODEL CONFIGURATION (CONFIDENTIAL / ENVIRONMENT SECRETS)
# Set your private model IDs via the Settings / Secrets panel in AI Studio.
# Never expose actual model identifiers in code or templates.
# ==============================================================================

# Core Text Model
NAJE_MODEL_CORE=

# Lite Text Model
NAJE_MODEL_LITE=

# Pro Text Model
NAJE_MODEL_PRO=

# Personas, Reviewers & Internal Agents Model
NAJE_MODEL_PERSONAS=

# Image Generation - Lite Tier
NAJE_MODEL_IMAGE_LITE=

# Image Generation - Core Tier
NAJE_MODEL_IMAGE_CORE=

# Image Generation - Pro Tier
NAJE_MODEL_IMAGE_PRO=

# Video Generation - Core Tier
NAJE_MODEL_VIDEO_CORE=

# Video Generation - Pro Tier
NAJE_MODEL_VIDEO_PRO=

# Voice Audio TTS - Core Model
NAJE_MODEL_VOICE_CORE=

# Voice Audio TTS - Pro Model
NAJE_MODEL_VOICE_PRO=

# PAYPAL CREDENTIALS & CONFIGURATION
# PAYPAL_CLIENT_ID: PayPal REST App Client ID (Public / API credential)
PAYPAL_CLIENT_ID="sb"

# PAYPAL_SECRET: PayPal REST App Secret (Server-side ONLY)
PAYPAL_SECRET="sb"

# PAYPAL_MODE: "sandbox" during testing or "live" in production
PAYPAL_MODE="sandbox"

# PAYPAL_WEBHOOK_ID: PayPal Webhook ID for signature verification
PAYPAL_WEBHOOK_ID="sb"

