    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "file-saver": "^2.0.5",
    "firebase": "^12.16.0",
